{
  "files.associations": {
    "*.json": "json"
  },
  "json.schemas": [
    {
      "fileMatch": ["**/ARM-templates/*.json"],
      "url": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#"
    }
  ],
  "json.enable": true,
  "editor.quickSuggestions": {
    "comments": "on",
    "strings": "on",
    "other": "on"
  },
  "editor.tabCompletion": "on",
  "editor.inlineSuggest.enabled": true
}